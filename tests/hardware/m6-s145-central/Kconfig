menu "NrfKit M6 S145 central fixture"

config NRFKIT_M6_CENTRAL_TARGET_NAME
	string "Exact peripheral name"
	default "nrfkit-m6-p2"

config NRFKIT_M6_CENTRAL_BOND
	bool "Request bonding"

config NRFKIT_M6_CENTRAL_LESC
	bool "Request LE Secure Connections"

choice NRFKIT_M6_CENTRAL_IO_CAPS
	prompt "SMP I/O capability"
	default NRFKIT_M6_CENTRAL_IO_NONE

config NRFKIT_M6_CENTRAL_IO_NONE
	bool "No input, no output"

config NRFKIT_M6_CENTRAL_IO_DISPLAY_YESNO
	bool "Display with yes/no confirmation"

config NRFKIT_M6_CENTRAL_IO_KEYBOARD_ONLY
	bool "Keyboard only"

endchoice

config NRFKIT_M6_CENTRAL_KDIST_OWN_ENC
	bool "Distribute local encryption key"

config NRFKIT_M6_CENTRAL_KDIST_OWN_ID
	bool "Distribute local identity key"

config NRFKIT_M6_CENTRAL_KDIST_PEER_ENC
	bool "Request peer encryption key"

config NRFKIT_M6_CENTRAL_KDIST_PEER_ID
	bool "Request peer identity key"

config NRFKIT_M6_CENTRAL_CLEAR_BONDS
	bool "Clear central bonds before scanning"

endmenu

source "Kconfig.zephyr"
