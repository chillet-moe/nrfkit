mainmenu "M5 laboratory radio peer"

source "Kconfig.zephyr"

config NRFKIT_M5_PEER_TX
	bool "Transmit the fixed M5 packet stream"
	default n

config NRFKIT_M5_PEER_RX
	bool "Receive and verify the fixed M5 packet stream"
	default n

config NRFKIT_M5_PEER_PHY_1M
	bool "Use the 1 Mbit diagnostic PHY"
	default n

config NRFKIT_M7_PEER_PHY_4M
	bool "Use a 4 Mbit primary PHY"
	default n

config NRFKIT_M7_PEER_4M_BT_0_4
	bool "Use the BT=0.4 4 Mbit mode instead of BT=0.6"
	depends on NRFKIT_M7_PEER_PHY_4M
	default n
