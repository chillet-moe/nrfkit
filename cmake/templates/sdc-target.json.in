{
  "schema": "nrfkit-sdc-target/v1",
  "target": "@target@",
  "variant": "@ARG_VARIANT@",
  "security_domain": "secure",
  "float_abi": "hard-float",
  "timeslot": $<IF:$<BOOL:$<TARGET_PROPERTY:@target@,NRFKIT_MPSL_TIMESLOT_ENABLED>>,true,false>,
  "archives": ["@root@/mpsl/lib/nrf54lm/hard-float/libmpsl.a", "@root@/mpsl/fem/common/lib/nrf54lm/hard-float/libmpsl_fem_common.a", "@root@/softdevice_controller/lib/nrf54lm/hard-float/libsoftdevice_controller_@ARG_VARIANT@.a"],
  "resources": ["@resources_json@"]
}
